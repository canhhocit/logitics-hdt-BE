
# CẤU HÌNH DATABASE (PostgreSQL)
DB_HOST=localhost
# Cổng kết nối DB (mặc định PostgreSQL là 5432)
DB_PORT=5432
# Tên database (vd: postgres, hdtlogistics,...)
DB_NAME=hdtlogistics
# Tên đăng nhập DB
DB_USER=postgres
# Mật khẩu DB
DB_PASS=mật_khẩu_của_bạn

# CẤU HÌNH REDIS (Upstash hoặc Local)

# Host kết nối Redis (vd: localhost hoặc url từ Upstash)
REDIS_HOST=localhost
REDIS_PORT=6379
# Mật khẩu Redis (Nếu dùng Upstash thì copy token. Nếu chạy local không có pass thì để trống)
REDIS_PASSWORD=
# Bật TLS/SSL cho Redis (điền `true` nếu dùng Upstash)
REDIS_SSL=false

# ==========================================
# CẤU HÌNH BẢO MẬT (JWT)
